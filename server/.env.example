PORT=4000

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

SQLITE_DB_PATH=./data/chatbot.db

TICKET_API_BASE_URL=http://localhost:7000
TICKET_API_TOKEN=
TICKET_API_ORG_ID=1
CUSTOMER_JWT_TTL_MINUTES=20

# Number of reverse proxies in front of this server. Leave at 0 when there is
# no proxy — the real caller IP is forwarded to the main app so its OTP rate
# limits apply per end user, and setting this too high lets callers spoof it.
TRUST_PROXY_HOPS=0
