PORT=4000

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

SQLITE_DB_PATH=./data/chatbot.db

TICKET_API_BASE_URL=http://localhost:7000
TICKET_API_TOKEN=
TICKET_API_ORG_ID=1
CUSTOMER_JWT_TTL_MINUTES=20

# Number of reverse proxies in front of this server. Leave at 0 when there is
# no proxy — the real caller IP is forwarded to the main app so its OTP rate
# limits apply per end user, and setting this too high lets callers spoof it.
TRUST_PROXY_HOPS=0

# Comma-separated origins allowed to embed the widget and call POST /chat.
# Optional in development (any origin is allowed, with a warning); required in
# production, where wide-open CORS lets any page anywhere drive the OTP sends
# behind this endpoint.
CHAT_CORS_ORIGINS=

# Messages allowed per IP per 5 minutes on POST /chat.
CHAT_RATE_LIMIT=30

# Ceiling on OTP emails this process will trigger per hour, whoever is asking.
# Per-IP limits do not stop a caller spread across many addresses, and every
# send costs real money.
OTP_HOURLY_CEILING=200

# How long a widget's settings (theme, tools, allowed sites) are cached after
# being fetched from the main app. Changes in Settings show up within this.
WIDGET_CONFIG_TTL_SECONDS=300

# Where files customers attach are held until their ticket exists. They are
# forwarded to the main app and deleted; unclaimed ones are purged after 24h.
ATTACHMENT_DIR=./data/attachments

# The built widget served at GET /widget.js. Defaults to ../client/dist/widget.js.
WIDGET_BUNDLE_PATH=
